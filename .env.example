# ==================================
# CineView Hub - Environment Variables
# ==================================

# This file contains all environment variables needed for the application
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to version control

# ==================================
# TMDB API Configuration
# ==================================

# The Movie Database (TMDB) API Key
# Get your API key from: https://www.themoviedb.org/settings/api
# 1. Create a TMDB account at https://www.themoviedb.org/
# 2. Navigate to Settings → API
# 3. Request an API key (it's free)
# 4. Copy the API Key (v3 auth)
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# ==================================
# Optional: CORS Proxy Configuration
# ==================================

# Only needed if TMDB API is blocked by your network/ISP/firewall
# Uncomment and configure one of these proxies if you experience connectivity issues:

# Option 1: corsproxy.io (Recommended)
# VITE_CORS_PROXY="https://corsproxy.io/?"

# Option 2: allorigins
# VITE_CORS_PROXY="https://api.allorigins.win/raw?url="

# See TMDB_TROUBLESHOOTING.md for more details on CORS proxy setup

# ==================================
# Optional: Analytics & Monitoring
# ==================================

# Google Analytics Measurement ID (optional)
# Format: G-XXXXXXXXXX
# VITE_GA_MEASUREMENT_ID=

# Sentry DSN for error tracking (optional)
# Get from: https://sentry.io/
# VITE_SENTRY_DSN=

# Enable debug mode (shows additional console logs)
# VITE_DEBUG_MODE=false

# Enable analytics tracking
# VITE_ENABLE_ANALYTICS=true

# ==================================
# Development Notes
# ==================================

# - All environment variables must start with VITE_ to be exposed to the client
# - Restart the development server after changing environment variables
# - Use strong, unique values for production deployments
# - Keep your .env file secure and never share it publicly
